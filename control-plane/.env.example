POSTGRES_DB=shieldbox
POSTGRES_USER=shieldbox
POSTGRES_PASSWORD=change_me_strong_password

DATABASE_URL=postgresql+asyncpg://shieldbox:change_me_strong_password@postgres:5432/shieldbox
REDIS_URL=redis://redis:6379/0

ADMIN_API_KEY=replace_with_random_64_char_secret
CLIENT_API_TOKEN_SALT=replace_with_random_salt

DEFAULT_TRAFFIC_LIMIT_BYTES=107374182400
DEFAULT_TRIAL_DAYS=30
MAX_DEVICES_PER_USER=5
SYNC_INTERVAL_SECONDS=30

# Inbound tags configured on Xray-core nodes
XRAY_VLESS_INBOUND_TAG=vless-reality-in
XRAY_CDN_INBOUND_TAG=vless-ws-in
